# Copy to .env and adjust. Never commit the real .env file.

# --- Database -----------------------------------------------------------
# SQLite (default) or a Postgres URL, e.g.
# postgresql+asyncpg://vigia:vigia@postgres:5432/vigia
DATABASE_URL=sqlite+aiosqlite:///./vigia.db

# --- Ollama / LLM ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Planner: decides the next agent step and drafts the report.
VIGIA_PLANNER_MODEL=qwen3.6:35b
# Extractor: normalizes/classifies tool output when deterministic rules aren't enough.
VIGIA_EXTRACTOR_MODEL=granite4.1:8b

# --- Secrets --------------------------------------------------------------
# Used to derive the Fernet key that encrypts API keys at rest. Generate a
# real random value for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VIGIA_SECRET_KEY=dev-insecure-change-me

# --- Agent budget -----------------------------------------------------------
VIGIA_SCAN_MAX_STEPS=60
VIGIA_SCAN_MAX_MINUTES=20
VIGIA_SCAN_MAX_DEEP_DIVES=5

# --- Optional third-party API keys (Phase 2+) ------------------------------
# Stored encrypted in the database via the Settings UI; these env vars are
# only a convenience for local/dev bootstrapping and are never sent to the LLM.
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# GITHUB_TOKEN=
# HIBP_API_KEY=

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
